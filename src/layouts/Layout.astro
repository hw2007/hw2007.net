---
import "../styles/style.css"

interface Props {
    title: string;
    tagline: string;
}

const { title, tagline } = Astro.props;
---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width" />
        <meta name="generator" content={Astro.generator} />
        <title>{title}</title>
    </head>
    <body style="text-align: center;">
        <!-- Page title -->
        <h1 style="
            padding-top: 35px;
            padding-bottom: 35px;
            padding-left: 5px;
            padding-right: 5px;
        ">{title}</h1>

        <!-- Page subtitle/tagline -->
        <p style="
            padding-top: 0px;
            padding-bottom: 35px;
            padding-left: 5px;
            padding-right: 5px;
        "><i>{tagline}</i></p>

        <slot />

    </body>
</html>