---
import "../styles/style.css"

interface Props {
    title: string;
    tagline: string;
}

const { title, tagline } = Astro.props;
---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width" />
        <meta name="generator" content={Astro.generator} />
        <title>{title}</title>

        <script>
            // Set the --x & --y variables that fancy-button relies on for the glowing effect based on mouse position
            const buttons = document.querySelectorAll(".fancy-button");
            window.addEventListener("mousemove", e => {
                buttons.forEach(btn => {
                    const rect = btn.getBoundingClientRect();
                    const x = e.clientX - rect.left;
                    const y = e.clientY - rect.top;
                    btn.style.setProperty("--x", x + "px");
                    btn.style.setProperty("--y", y + "px");
                });
            });
        </script>
    </head>
    <body style="text-align: center;">
        <!-- Page title -->
        <h1 style="
            margin-top: 60px;
            margin-bottom: 60px;
            margin-left: 5px;
            margin-right: 5px;
        ">
            <!-- Wrap the header in a slot so that it can be customized (e.g. on the index page) -->
            <slot name="header">{title}</slot>
        </h1>

        <!-- Page subtitle/tagline -->
        <p style="
            margin-top: 0px
            margin-bottom: 35px
            margin-left: 5px
            margin-right: 5px
        "><i>{tagline}</i></p>

        <slot />

    </body>
</html>