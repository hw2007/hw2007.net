---
import Layout from "./BaseLayout.astro"

interface Props {
    title: string;
    tagline: string;
}

const { title, tagline } = Astro.props;
---

<Layout title={title} tagline={tagline}>
    <a href="javascript:history.back()" style="
        position: absolute;
        top: -6px;
        left: 0px;
        padding: 20px;
    ">
        ← Back
    </a>

    <slot />
</Layout>