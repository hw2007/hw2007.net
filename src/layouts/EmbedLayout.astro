---
import BaseLayout from "./BaseLayout.astro";
import BackButton from "../components/BackButton.astro";

interface Props {
    title: string;
    src: string;
}

const { title, src } = Astro.props;
---

<BaseLayout title={title}>
    <BackButton />
    <main style="text-align: center;">
        <!-- Page title -->
        <p style="margin-top: 16px">{title}</p>

        <!-- Embedded site -->
        <div style="
            display: flex;
            position: absolute; 
            top: 60px;
            bottom: 0px;
            left: 0px;
            right: 0px;
        ">
            <iframe src={src} title={title} allowfullscreen style="width: 100%; height:100%; border-width: 1px;"/>
        </div>
    </main>
</BaseLayout>