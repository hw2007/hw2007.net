---
import StandardLayout from "../layouts/StandardLayout.astro";
import ButtonColumns from "../components/ButtonColumns.astro";

const pages = [
    {
        title: "All the pages!",
        items: [
            {
                title: "Arcade",
                image: "/src/icons/index/arcade.png",
                href: "/arcade"
            },
            {
                title: "Projects",
                image: "/src/icons/index/projects.png",
                href: "/projects"
            },
            {
                title: "Internet Speed Test",
                image: "/src/icons/index/speedtest.png",
                href: "/speedtest"
            },
            {
                title: "Source Code",
                image: "/src/icons/index/code.png",
                href: "https://github.com/hw2007/hw2007.net"
            },
            {
                title: "Minecraft Server",
                image: "/src/icons/index/minecraftserver.png",
                href: "/minecraft"
            }
        ]
    },
    {
        title: "More from me on...",
        items: [
            {
                title: "Itch.io",
                image: "/src/icons/index/itchio.png",
                href: "https://hw2007.itch.io/"
            },
            {
                title: "GitHub",
                image: "/src/icons/index/github.png",
                href: "https://github.com/hw2007"
            }
        ]
    }
];
---

<StandardLayout title="hw2007.net" tagline="welcome home!" showBackButton={false}>
    <style>
        @media (max-width: 750px) {
            .desktop-only {
                display: none;
            }
        }
        .net-text {
            text-decoration: none;
        }
        .net-text:hover {
            font-family: var(--font-family);
            font-weight: 700;
        }
        .net-text span:first-child {
            color: var(--lightblue);
        }
        .net-text span{
            color: var(--blue);
        }
        .net-text span:last-child {
            color: var(--purple);
        }
        .net-text:hover span {
            color:var(--fg);
        }
    </style>
    <Fragment slot="header">
        <span class="desktop-only">Welcome to </span>hw2007.<a class="net-text" href="/demo"><span>n</span><span>e</span><span>t</span></a><span class="desktop-only">!</span>
    </Fragment>
    <ButtonColumns columns={pages} imageHeight={32} />
</StandardLayout>