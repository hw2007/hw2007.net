    <p>Grid of fancy-buttons:</p>
    <div class="button-grid">
        <a href="/demo" class="fancy-button">Link</a>
        <a href="/demo" class="fancy-button">Link</a>
        <button class="fancy-button">Button</button>
        <button class="fancy-button">Button</button>
        <a href="/demo" class="fancy-button">Link</a>
