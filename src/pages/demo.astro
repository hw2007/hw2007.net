---
import Layout from "../layouts/LayoutWithBack.astro"
---

<Layout title="CSS Demo" tagline="see what various elements look like under the sitewide styling">
    <h1>h1</h1>
    <h2>h2</h2>
    <h3>h3</h3>
    <h4>h4</h4>
    <h5>h5</h5>
    <h6>h6</h6>
