---
import ButtonGrid from "./ButtonGrid.astro";
import type { Item } from "./ButtonGrid.astro";

interface Column {
    title?: string;
    items: Item[];
}

interface Props {
    columns: Column[];
    imageHeight?: number; // measured in px
    minColumnWidth?: number; // measured in px
}

const { columns, imageHeight, minColumnWidth=256} = Astro.props;
---

<style>
    .button-cols {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(var(--min-column-width), 1fr));
        gap: 16px;
    }
</style>

<div class="button-cols" style={`--min-column-width: ${minColumnWidth}px`}>
    {columns.map((col) => (
        <div>
            { // Only create the title paragraph if col.title is set
                col.title && (
                    <p style="margin-bottom: 16px;">{col.title}</p>
                )
            }
            <ButtonGrid items={col.items} imageHeight={imageHeight+"px"} />
        </div>
    ))}
</div>