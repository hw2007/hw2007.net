---
import { map } from 'astro:schema';

export interface Item {
    title: string;
    description?: string;
    image?: string;
    href: string;
}

interface Props {
    items: Item[];
    maxCols?: number;
    minColWidth?: number // measured in px
    imageHeight?: string; // string like "64px"
}

const { items, maxCols = 1, minColWidth=0, imageHeight} = Astro.props;
---

<style>
    .button-grid {
        display: grid;
       grid-template-columns: repeat(auto-fit, minmax(max(var(--min-column-width), calc(100% / var(--max-columns))), 1fr));
        gap: 0px;
    }

    /* Overlapping borders */
    .button-grid .fancy-button {
        margin-top: -4px;
        margin-left: -4px;
    }
</style>

<div class="button-grid" style={`--max-columns: ${maxCols}; --min-column-width: ${minColWidth}px`}>
    {items.map((item) => (
        <a class="fancy-button" href={item.href}>
            { // Only create the image if item.image is set
                item.image && (
                    <img src={item.image} style={`
                        margin-right: 8px;
                        image-rendering: pixelated;
                        height: ${imageHeight ?? "auto"};
                    `}>
                )
            }
            <p>
                {item.title}
                <br>
                <span style="color: var(--fg)">
                    {item.description}
                </span>
            </p>
        </a>
    ))}
</div>